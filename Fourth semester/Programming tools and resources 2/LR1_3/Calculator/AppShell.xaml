<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Calculator.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Calculator"
    Title="Calculator">

    <FlyoutItem Title="Главная" Icon="dotnet_bot.png">
        <ShellContent Title="Главная" ContentTemplate="{DataTemplate local:MainPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Калькулятор" Icon="dotnet_bot.png">
        <ShellContent Title="Калькулятор" ContentTemplate="{DataTemplate local:CalculatorPage}" />
    </FlyoutItem>

</Shell>
