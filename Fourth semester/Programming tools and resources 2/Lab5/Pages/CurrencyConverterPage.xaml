<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Lab5.Pages.CurrencyConverterPage"
             Title="Конвертер валют">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Выберите дату:" FontSize="16" FontAttributes="Bold" />
            <DatePicker x:Name="DatePicker" 
            Format="d"  
                DateSelected="DatePicker_DateSelected"
            WidthRequest="250"
            HorizontalOptions="Start" />

            <Label Text="Выберите валюту:" FontSize="16" FontAttributes="Bold" />
            <Picker x:Name="CurrencyPicker" 
                    Title="Валюта"
                    SelectedIndexChanged="CurrencyPicker_SelectedIndexChanged"
                    VerticalOptions="Start"/>

            <Label Text="Сумма:" FontSize="16" FontAttributes="Bold" />
            <Entry x:Name="AmountEntry" 
                   Placeholder="Введите сумму"
                   Keyboard="Numeric" />

            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                <Button Text="BYN → Валюта" 
                        Clicked="ConvertToCurrency_Clicked" />
                <Button Text="Валюта → BYN" 
                        Clicked="ConvertToByn_Clicked" />
            </HorizontalStackLayout>

            <Label x:Name="ResultLabel" 
                   Text="Результат: " 
                   FontSize="18" 
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <ActivityIndicator x:Name="LoadingIndicator" 
                               IsRunning="False" 
                               IsVisible="False" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>