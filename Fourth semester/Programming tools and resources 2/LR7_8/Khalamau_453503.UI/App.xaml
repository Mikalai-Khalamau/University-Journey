<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Khalamau_453503.UI"
             xmlns:converters="clr-namespace:Khalamau_453503.UI.ValueConverters"
             x:Class="Khalamau_453503.UI.App">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:DevelopmentLevelToColorConverter x:Key="DevelopmentLevelToColorConverter"/>
            <converters:IdToImageConverter x:Key="IdToImageConverter"/>

        </ResourceDictionary>
    </Application.Resources>
</Application>