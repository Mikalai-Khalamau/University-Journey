<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Khalamau_453503.UI.ViewModels"
             x:DataType="vm:EditPizzaViewModel"
             x:Class="Khalamau_453503.UI.Pages.EditPizzaPage"
             Title="Edit Pizza">

    <VerticalStackLayout Padding="20" Spacing="15">

        <Label Text="Name:" FontAttributes="Bold"/>
        <Entry Text="{Binding Name}" Placeholder="Enter pizza name"/>

        <Label Text="Time (minutes):" FontAttributes="Bold"/>
        <Entry Text="{Binding Time}" Keyboard="Numeric" Placeholder="Enter time"/>

        <Button Text="Save" 
                Command="{Binding SaveCommand}"
                BackgroundColor="Green"
                TextColor="White"
                Margin="0,20,0,0"/>
    </VerticalStackLayout>
</ContentPage>