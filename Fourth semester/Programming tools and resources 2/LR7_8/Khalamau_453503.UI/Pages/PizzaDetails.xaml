<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:Khalamau_453503.UI.ValueConverters"
             x:Class="Khalamau_453503.UI.Pages.PizzaDetails"
             Title="Pizza Details">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Edit" Command="{Binding EditCommand}"/>
        <ToolbarItem Text="Delete" Command="{Binding DeleteCommand}"/>
        <ToolbarItem Text="Image" Command="{Binding SelectImageCommand}"/>
    </ContentPage.ToolbarItems>

    <VerticalStackLayout Padding="20" Spacing="15">

        <Image Source="{Binding Pizza.Id, Converter={StaticResource IdToImageConverter}}"
               HeightRequest="250"
               WidthRequest="250"
               HorizontalOptions="Center"
               Aspect="AspectFit"/>

        <Label Text="{Binding Pizza.Name, StringFormat='{0}'}" 
               FontSize="24" FontAttributes="Bold" HorizontalOptions="Center"/>

        <Label Text="{Binding Pizza.Time, StringFormat='Время: {0} мин'}" 
               FontSize="18" HorizontalOptions="Center"/>

        <Label Text="{Binding Pizza.OrderId, StringFormat='Заказ №{0}'}" 
               FontSize="16" HorizontalOptions="Center" TextColor="Gray"/>

    </VerticalStackLayout>
</ContentPage>