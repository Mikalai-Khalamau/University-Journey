@if (SelectedDish is null)
{
    <div class="alert alert-light border mt-4">
        Нажмите кнопку «Подробно» рядом с названием камня, чтобы увидеть подробную информацию.
    </div>
}
else
{
    <div class="card mt-4 shadow-sm">
        <div class="row g-0">
            @if (!string.IsNullOrWhiteSpace(SelectedDish.Image))
            {
                <div class="col-md-4">
                    <img src="@SelectedDish.Image" class="img-fluid rounded-start h-100" alt="@SelectedDish.Name"
                         style="object-fit: cover;" />
                </div>
            }
            <div class="col-md-8">
                <div class="card-body">
                    <h3 class="card-title">@SelectedDish.Name</h3>
                    <p class="card-text">@SelectedDish.Description</p>
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Категория</dt>
                        <dd class="col-sm-8">@(SelectedDish.Type?.Name ?? "не указана")</dd>

                        <dt class="col-sm-4">Цена</dt>
                        <dd class="col-sm-8">@SelectedDish.Price.ToString("N2") руб.</dd>

                        <dt class="col-sm-4">Идентификатор</dt>
                        <dd class="col-sm-8">@SelectedDish.Id</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public Gem? SelectedDish { get; set; }
}
