{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "Serilog": {
        "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "System": "Warning"
            }
        },
        "WriteTo": [
            { "Name": "Console" },
            {
                "Name": "File",
                "Args": {
                    "path": "logs/log-.txt",
                    "rollingInterval": "Day"
                }
            }
        ]
    },
    "AllowedHosts": "*",
    "ItemsPerPage": 3,
    "UriData": {
        "ApiUri": "https://localhost:7133/api/"
    },
    "Keycloak": {
        "Host": "http://localhost:8080",
        "Realm": "Khalamau",
        "ClientId": "KhalamauUiClient",
        "ClientSecret": "oIUBlPoeJCUsI0hyJqRKMLCp3jJwjANR"
    }
}
