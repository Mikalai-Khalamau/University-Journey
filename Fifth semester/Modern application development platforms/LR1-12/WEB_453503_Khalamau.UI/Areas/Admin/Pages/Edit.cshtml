@page
@model WEB_453503_Khalamau.UI.Areas.Admin.Pages.EditModel


<h4>Gem</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Gem.Id" />
            <input type="hidden" asp-for="Gem.Image" />
            <div class="form-group">
                <label asp-for="Gem.Name" class="control-label"></label>
                <input asp-for="Gem.Name" class="form-control" />
                <span asp-validation-for="Gem.Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Gem.Description" class="control-label"></label>
                <input asp-for="Gem.Description" class="form-control" />
                <span asp-validation-for="Gem.Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Gem.Price" class="control-label"></label>
                <input type="text" class="form-control" id="Gem_Price" name="Gem.Price"
                       value="@(Model.Gem?.Price)" data-val="true"
                       data-val-required="The Price field is required." />
                <span asp-validation-for="Gem.Price" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label class="control-label">Тип</label>
                <select asp-for="Gem.TypeId" asp-items="Model.GemTypes" class="form-select">
                    <option value="">-- выберите тип --</option>
                </select>
                <span asp-validation-for="Gem.TypeId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label class="control-label">Текущее изображение</label>
                <div>
                    <img src="@(Model.Gem?.Image)" alt="@(Model.Gem?.Name)" style="max-width: 200px; max-height: 200px;" />
                </div>
            </div>
            <div class="form-group">
                <label asp-for="Image" class="control-label">Заменить изображение</label>
                <input asp-for="Image" type="file" class="form-control" accept="image/*" />
                <span asp-validation-for="Image" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}