@model Cart
@{
    ViewData["Title"] = "Корзина заказов";
}

<h2 class="mb-4">Корзина заказов</h2>

@if (Model.CartItems.Count == 0)
{
    <div class="alert alert-info">Корзина пуста</div>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Товар</th>
                <th>Название</th>
                <th>Цена</th>
                <th>Количество</th>
                <th>Сумма</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var entry in Model.CartItems)
            {
                var item = entry.Value.Item;
                <tr>
                    <td>
                        <img src="@item.Image" alt="@item.Name" style="width: 50px; height: 50px; object-fit: cover;" class="rounded" />
                    </td>
                    <td>@item.Name</td>
                    <td>@item.Price $</td>
                    <td>@entry.Value.Count</td>
                    <td>@(item.Price * entry.Value.Count) $</td>
                    <td>
                        <form asp-controller="Cart" asp-action="Remove" asp-route-id="@item.Id" method="post">
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                            <button type="submit" class="btn btn-danger btn-sm">Удалить</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="4" class="text-end fw-bold">Итого:</td>
                <td colspan="2" class="fw-bold">@Model.TotalPrice $</td>
            </tr>
        </tfoot>
    </table>

    <form asp-controller="Cart" asp-action="Clear" method="post">
        <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
        <button type="submit" class="btn btn-outline-danger">Очистить корзину</button>
    </form>
}
