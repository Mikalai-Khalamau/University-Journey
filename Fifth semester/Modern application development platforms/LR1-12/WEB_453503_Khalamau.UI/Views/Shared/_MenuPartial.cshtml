@{
    var currentController = ViewContext.RouteData.Values["controller"]?
                                        .ToString()?
                                        .ToLower() ?? "";
}

<a class="navbar-brand badge bg-primary text-white px-2" 
   asp-controller="Home" 
   asp-action="Index">
    453503
</a>

<div class="navbar-nav me-auto">
    <a class="nav-item nav-link @(currentController == "home" ? "active" : "")" 
       asp-controller="Home" 
       asp-action="Index">
        Лб 1
    </a>
    
    <a class="nav-item nav-link @(currentController == "gem" ? "active" : "")"
   asp-controller="Gem"
   asp-action="Index">
    Каталог
</a>
    
    @if (User.Identity?.IsAuthenticated == true && User.IsInRole("POWER-USER"))
    {
        <a class="nav-item nav-link" 
           asp-area="Admin" 
           asp-page="/Index">
            Администрирование
        </a>
    }
</div>