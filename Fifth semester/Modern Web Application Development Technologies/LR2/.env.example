# Copy to .env and adjust (optional for local non-Docker runs).

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite by default. For PostgreSQL (Docker / prod) set either:
# POSTGRES_HOST=db
# POSTGRES_USER=insurance
# POSTGRES_PASSWORD=insurance
# POSTGRES_DB=insurance
# or a single URL (Render / Railway often provide this):
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Behind HTTPS reverse proxy (Render / Railway):
# DJANGO_BEHIND_PROXY=true
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com
# DJANGO_SECURE_COOKIES=true
